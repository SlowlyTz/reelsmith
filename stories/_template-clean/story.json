      "id": "vo1",
      "scene": "hook",
      "at": 0.1,
      "text": "Warum gähnst du, wenn andere gähnen? Das ist kein Zufall."
    },
    {
      "id": "vo2",
      "scene": "hirn",
      "at": 0.1,
      "text": "Forscher vermuten: Gähnen kühlt dein Gehirn, wie ein kleiner Ventilator."
    },
    {
      "id": "vo3",
      "scene": "notiz",
      "at": 0.1,
      "text": "Und es steckt an, weil dein Gehirn andere Menschen unbewusst nachmacht."
    },
    {
      "id": "vo4",
      "scene": "suche",
      "at": 0.1,
      "text": "Mehr dazu? Such einfach nach Spiegelneuronen.",
      "sub": "Mehr dazu? Such einfach nach *Spiegelneuronen.*"
    }
  ]
